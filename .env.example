# ReplyLo environment — copy to .env and fill in when ready.
# Everything is empty by default; the backend then runs in DRY-RUN mode.

PORT=3000
VERIFY_TOKEN=my-verify-token

# --- Admin account (created on first boot, then safe to remove) ---
# Sign in at /login with these to reach /admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Meta app (leave empty for now) ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# --- Graph API URLs (leave empty for now) ---
GRAPH_API_BASE=
GRAPH_API_BETA_BASE=

# --- This server's public URL (ngrok etc.), empty for now ---
# When set, POST/PATCH/DELETE requests with a different Origin header are rejected.
PUBLIC_BASE_URL=

# --- Behaviour ---
REMINDER_MINUTES=60

# --- Storage / security ---
# SQLite file (default data/replylo.db; on Fly use /data/replylo.db)
DATABASE_PATH=data/replylo.db
# 32 random bytes, base64. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts stored Instagram access tokens (AES-256-GCM). Set before first connect.
TOKEN_ENC_KEY=
# Nightly VACUUM INTO backup directory (keeps 7 files)
BACKUP_DIR=data/backups
# pino log level: fatal|error|warn|info|debug|trace (default info in production)
LOG_LEVEL=

# --- Billing ---
# Payment provider: "mock" (dev/test, no real money) or "razorpay".
# mock NEVER grants payments when NODE_ENV=production.
BILLING_PROVIDER=mock
# Required when BILLING_PROVIDER=razorpay (leave empty otherwise).
# Never commit real keys; set them as fly secrets.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
