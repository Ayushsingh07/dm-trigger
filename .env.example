# ReplyLo environment — copy to .env and fill in when ready.
# Everything is empty by default; the backend then runs in DRY-RUN mode.

PORT=3000
VERIFY_TOKEN=my-verify-token

# --- Admin account (created on first boot, then safe to remove) ---
# Sign in at /login with these to reach /admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Meta app (leave empty for now; never commit real credentials) ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
# Which Instagram login product the Meta app has. Must match the product added
# in the app dashboard, or Meta returns "Invalid platform app":
#   instagram -> Instagram API with Instagram Login  (instagram.com login,  graph.instagram.com)
#   facebook  -> Instagram API with Facebook Login   (facebook.com login,   graph.facebook.com)
#   business  -> UNIFIED LOGIN: "Facebook Login for Business" with a
#                configuration. Dialog = facebook.com/dialog/oauth?client_id=..
#                &config_id=.. (no scope; permissions come from the config),
#                tokens on graph.facebook.com. Recommended for new apps.
META_OAUTH_FLOW=instagram
# Required when META_OAUTH_FLOW=business. Meta dashboard > Account
# Authorization > Configurations > copy the configuration id.
# The redirect URI below must be added to that configuration's allowed
# redirect URIs, character for character.
META_CONFIG_ID=
