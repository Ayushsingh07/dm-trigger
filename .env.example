# Optional overrides for the unified-login dialog. Defaults match the Login URL
# Meta generates in the dashboard (display=popup, prompt=login).
# Set META_LOGIN_PROMPT=none to omit prompt entirely (skips forced re-auth).
META_DIALOG_DISPLAY=popup
META_LOGIN_PROMPT=login
