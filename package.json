{
  "name": "dm-trigger",
  "version": "1.0.0",
  "description": "ReplyLo — Instagram keyword comment auto-reply SaaS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:css": "tailwindcss -i src/styles/tailwind.css -o public/assets/app.css --minify",
    "build:js": "esbuild src/landing.jsx --bundle --minify --target=es2020 --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --outfile=public/assets/landing.js",
    "build": "npm run build:css && npm run build:js",
    "watch": "tailwindcss -i src/styles/tailwind.css -o public/assets/app.css --watch",
    "test": "node --test \"test/*.test.js\""
  },
  "keywords": [],
  "type": "commonjs",
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "pino": "9.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.11",
    "esbuild": "0.25.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.5": true,
    "@tailwindcss/oxide@4.1.11": true,
    "@parcel/watcher@2.6.0": true
  }
}
